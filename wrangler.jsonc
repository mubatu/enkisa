{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enkisa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Tek adres: enkisa.tr. workers.dev kapalı, yoksa kısa linkler iki farklı domain'le üretilir.
  "routes": [{ "pattern": "enkisa.tr", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Arayüz. Eşleşen dosya yoksa istek Worker'a düşer (kısa link yönlendirmesi).
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enkisa",
      "database_id": "5b3f1493-9c2e-4eaf-a938-5c25f8e11a83",
      "migrations_dir": "migrations"
    }
  ],

  // IP başına dakikada en fazla 10 yeni link.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
